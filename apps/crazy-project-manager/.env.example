# 默认监听本机。需要在同一局域网用手机扫码时，改为 0.0.0.0 并填写可达的 STUDIO_PUBLIC_URL。
HOST=127.0.0.1
PORT=4173
# STUDIO_PUBLIC_URL=http://192.168.1.23:4173
# STUDIO_DATA_DIR=

# TTS 可以在网页中选择 local、fish、openrouter 或 volcengine。
STUDIO_TTS_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TTS_URL=https://openrouter.ai/api/v1/audio/speech
OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
OPENROUTER_VOICE_ZHOU=gareth
OPENROUTER_VOICE_LIN=sabrina
OPENROUTER_VOICE_TANG=lucian
OPENROUTER_VOICE_YI=bram

# 火山引擎新版控制台的豆包语音 API Key。
VOLCENGINE_API_KEY=
VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_VOICE_ZHOU=zh_male_m191_uranus_bigtts
VOLCENGINE_VOICE_LIN=zh_female_xiaohe_uranus_bigtts
VOLCENGINE_VOICE_TANG=zh_male_yangguangqingnian_uranus_bigtts
VOLCENGINE_VOICE_YI=zh_male_taocheng_uranus_bigtts

# Fish 合成与识别可单独配置密钥。已有 FISH_API_KEY 的环境可省略两个分开的键名。
FISH_TTS_API_KEY=
FISH_ASR_API_KEY=
# FISH_API_KEY=
# FISH_TTS_URL=https://api.fish.audio/v1/tts
# FISH_ASR_URL=wss://api.fish.audio/v1/asr/realtime

# 火山录音文件识别标准版使用独立的 API Key 和外网可达的 HTTPS 录音地址。
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLCENGINE_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
# 存量极速版账号可单设此密钥。
# VOLCENGINE_FLASH_ASR_KEY=
# VOLCENGINE_FLASH_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash

# 选择 STUDIO_ASR_MODE=volcengine-sentence 开启豆包一句话识别。松手后返回整句，默认复用 VOLCENGINE_ASR_API_KEY。
# VOLCENGINE_SENTENCE_ASR_API_KEY=
# VOLCENGINE_SENTENCE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 如开通的是流式语音识别 2.0 并发版，使用 volc.seedasr.sauc.concurrent。
# FISH_MODEL=s2.1-pro
FISH_VOICE_ZHOU=
FISH_VOICE_LIN=
FISH_VOICE_TANG=
FISH_VOICE_YI=
STUDIO_ASR_MODE=browser

# OpenCode Go 预设的接口为 https://opencode.ai/inference/go/openai/v1/chat/completions
# 模型为 hy4-flash-free，支持 PNG 评审。填入订阅 API Key 即启用。
STUDIO_AGENT_MODE=opencode-go
OPENCODE_GO_API_KEY=
# 自建 Chat Completions 接口时，改 STUDIO_AGENT_MODE=api 并填写以下三项。
STUDIO_MODEL_URL=
STUDIO_MODEL=
STUDIO_MODEL_KEY=
STUDIO_VISION_MODE=inherit
# 使用独立的视觉模型时改 STUDIO_VISION_MODE=api，并填以下三项。
STUDIO_VISION_URL=
STUDIO_VISION_MODEL=
STUDIO_VISION_KEY=

# 图片生成使用 AMD Creative Hub 的 MiniMax-H3-Image。启用时将模式设为 amd 并填写个人 API Key。
STUDIO_IMAGE_MODE=off
AMD_CREATIVE_HUB_API_KEY=
